{
  "name": "toeic-progress",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@toeic-progress/frontend --",
    "build": "npm run build --workspace=@toeic-progress/frontend --",
    "preview": "npm run preview --workspace=@toeic-progress/frontend --",
    "test": "npm run test --workspace=@toeic-progress/frontend --",
    "lint": "npm run lint --workspace=@toeic-progress/frontend --",
    "typecheck": "npm run typecheck --workspace=@toeic-progress/frontend --",
    "test:e2e": "playwright test",
    "test:rls": "node tests/staging/rls.mjs",
    "test:staging": "node tests/staging/smoke.mjs",
    "test:db": "node tests/database/test-database.mjs && node tests/database/test-domain-tables.mjs && node tests/database/test-content-purge.mjs && node tests/database/test-api-limits.mjs && node tests/database/test-provider-retirement.mjs && node tests/database/test-ai-access.mjs && node tests/database/test-explanation-ledger.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@supabase/supabase-js": "^2.117.0"
  }
}
