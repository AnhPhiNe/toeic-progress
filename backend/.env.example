SUPABASE_URL=
ENVIRONMENT=development
# Deploy tracker beta first; enable AI only after configuring the provider + CAPTCHA.
AI_ENABLED=false
# Enable only after applying 20261011000000_ai_access_grants.sql.
# Pending/blocked users and guests cannot use AI; approve each account in Supabase.
AI_ACCESS_MANAGED=false
# Private source images require the mistake-sources bucket (see backend/README.md).
SOURCE_IMAGES_ENABLED=false
SOURCE_IMAGE_ACCOUNT_LIMIT=200
# OpenAI handles reading images and explaining questions. Keep keys on the backend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=8192
OPENAI_TIMEOUT_SECONDS=45
# Advice on one logged test (same OpenAI key and AI quotas). Output limit includes reasoning tokens.
OPENAI_ADVICE_REASONING_EFFORT=medium
OPENAI_ADVICE_MAX_OUTPUT_TOKENS=6144
OPENAI_ADVICE_TIMEOUT_SECONDS=60
# Set true after applying 20261006020000_api_rate_limits.sql; required in staging/production.
API_LIMITS_ENABLED=false
# Exact API hostnames. Render's RENDER_EXTERNAL_HOSTNAME is used automatically when empty.
ALLOWED_HOSTS=[]
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=["localhost","127.0.0.1"]
# Random secret used to hash IP addresses; never send to the browser.
RATE_LIMIT_SECRET=
AI_GUEST_LIMIT=3
AI_ACCOUNT_MONTHLY_LIMIT=10
# Backend-only allowlist of Google-verified Gmail addresses. Empty means no exemptions.
# Exempts ALL app AI quotas and account/IP AI spam limits; provider quotas remain.
AI_UNLIMITED_EMAILS=[]
# App usage caps; configure provider budget separately on OpenAI Platform.
AI_GLOBAL_DAILY_LIMIT=20
AI_GLOBAL_MINUTE_LIMIT=2
AI_IP_DAILY_LIMIT=5
INGRESS_IP_MINUTE_LIMIT=120
# Behind Render: verify with CLIENT_IP_DEBUG=true and /debug/client-ip first (docs/DEPLOYMENT.md).
CLIENT_IP_HEADER=
CLIENT_IP_DEBUG=false
MAX_CONCURRENT_REQUESTS=8
BODY_TIMEOUT_SECONDS=10
API_ACCOUNT_MINUTE_LIMIT=60
API_SYNC_MINUTE_LIMIT=30
API_USAGE_MINUTE_LIMIT=30
API_AI_MINUTE_LIMIT=10
API_DESTRUCTIVE_MINUTE_LIMIT=3
