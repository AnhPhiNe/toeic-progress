SUPABASE_URL=
ENVIRONMENT=development
# Deploy tracker beta first; enable AI only after configuring Gemini + CAPTCHA.
AI_ENABLED=false
# Set true after applying 20261006020000_api_rate_limits.sql; required in staging/production.
API_LIMITS_ENABLED=false
# Exact API hostnames. Render's RENDER_EXTERNAL_HOSTNAME is used automatically when empty.
ALLOWED_HOSTS=[]
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
# Simple pool: each key has independent quota (one key per account/project), max 8.
GEMINI_API_KEYS=[]
# Advanced grouping only when several keys share a project; do not combine modes.
# JSON: [{"project_id":"real-google-project-id","api_keys":["secret-key"],"rpm_limit":5,"tpm_limit":250000,"rpd_limit":20}]
GEMINI_PROJECTS=[]
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=["gemini-3.7-flash","gemini-3.6-flash","gemini-3.5-flash"]
GEMINI_RPM_LIMIT=5
GEMINI_TPM_LIMIT=250000
GEMINI_RPD_LIMIT=20
GEMINI_MAX_CONCURRENT=2
GEMINI_KEY_MAX_CONCURRENT=1
GEMINI_MAX_ATTEMPTS=8
GEMINI_ATTEMPT_TIMEOUT_SECONDS=30
GEMINI_TOTAL_TIMEOUT_SECONDS=60
GEMINI_RPM_COOLDOWN_SECONDS=60
GEMINI_RPD_COOLDOWN_SECONDS=86400
# Keep this Google project on Free Tier without linking a billing account.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=["localhost","127.0.0.1"]
# Random secret used to hash IP addresses; never send to the browser.
RATE_LIMIT_SECRET=
AI_GUEST_LIMIT=3
AI_ACCOUNT_MONTHLY_LIMIT=10
# Backend-only allowlist of Google-verified Gmail addresses. Empty means no exemptions.
# Exempts user/month, app/day and IP/day caps; minute/API/provider caps remain active.
AI_UNLIMITED_EMAILS=[]
# Adjust below the actual RPM/TPM/RPD limits shown in AI Studio.
AI_GLOBAL_DAILY_LIMIT=20
AI_GLOBAL_MINUTE_LIMIT=2
AI_IP_DAILY_LIMIT=5
INGRESS_IP_MINUTE_LIMIT=120
MAX_CONCURRENT_REQUESTS=8
BODY_TIMEOUT_SECONDS=10
API_ACCOUNT_MINUTE_LIMIT=60
API_SYNC_MINUTE_LIMIT=30
API_USAGE_MINUTE_LIMIT=30
API_AI_MINUTE_LIMIT=10
API_DESTRUCTIVE_MINUTE_LIMIT=3
